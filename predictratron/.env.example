# HA root URL, without /api. Use a trusted HTTPS hostname, or local HTTP.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Alternative: mount a secret file in the container and set its path.
# HA_TOKEN_FILE=/run/secrets/ha_token
# Optional custom certificate authority, mounted in the container:
# HA_CA_FILE=/run/secrets/ha_ca.pem
# Set this when allowing access to the app beyond localhost.
APP_TOKEN=
